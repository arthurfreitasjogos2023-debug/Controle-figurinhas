{
  "appId": "br.com.copa2026.album",
  "appName": "Copa 2026 - Álbum",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "buildOptions": {
      "signingType": "apksigner"
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#02050c",
      "androidSpinnerStyle": "large",
      "spinnerColor": "#2563eb",
      "showSpinner": true
    },
    "StatusBar": {
      "style": "Dark",
      "backgroundColor": "#02050c"
    }
  }
}
